# Eval workspaces (local testing artifacts)
*-workspace/

# OS files
.DS_Store

# Claude local files — entirely user-private. The maintainer skill and
# its slash command live under the maintainer's home directory
# (~/Utility/SKILLS/ETYB and ~/.claude/commands/), not in this repo.
.claude/

# Internal documents (not for public distribution)
MARKETPLACE.md
docs/plan-*.md
.internal/

# ETYB runtime artifacts (created during usage)
.etyb/

# Python bytecode from Codex hook execution
__pycache__/
*.pyc

# Local install artifacts (legacy v4 installer output; kept ignored for old clones
# when run with this repo as both source and target during development)
.agents/

# Upstream-skill lockfile from external tooling, not part of etyb-skills
skills-lock.json
